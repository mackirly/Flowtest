                    </div>
                    
                    <!-- Repository Settings -->
                    <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
                        <h3 class="text-lg font-medium mb-4" data-i18n="repositorySettings">Repository Settings</h3>
                        
                        <form id="repository-settings-form">
                            <div class="space-y-4 mb-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium" data-i18n="autoSync">Automatic Synchronization</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="autoSyncDesc">Automatically sync repositories on a schedule</p>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" name="auto_sync" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                
                                <div>
                                    <label for="sync-frequency" class="block text-sm font-medium mb-1" data-i18n="syncFrequency">Sync Frequency</label>
                                    <select id="sync-frequency" name="sync_frequency" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700">
                                        <option value="15" data-i18n="minutes15">Every 15 minutes</option>
                                        <option value="30" data-i18n="minutes30">Every 30 minutes</option>
                                        <option value="60" selected data-i18n="hours1">Every hour</option>
                                        <option value="360" data-i18n="hours6">Every 6 hours</option>
                                        <option value="720" data-i18n="hours12">Every 12 hours</option>
                                        <option value="1440" data-i18n="daily">Daily</option>
                                    </select>
                                </div>
                                
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium" data-i18n="webhookIntegration">Webhook Integration</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="webhookIntegrationDesc">Listen for repository webhook events to trigger synchronization</p>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" name="webhook_integration" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium" data-i18n="syncOnConnect">Sync on Connect</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="syncOnConnectDesc">Automatically sync repositories when they are connected</p>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" name="sync_on_connect" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                            
                            <div class="flex justify-end">
                                <button type="submit" class="px-4 py-2 bg-coral-500 text-white rounded-lg hover:bg-coral-600 focus:outline-none focus:ring-4 focus:ring-coral-300">
                                    <span data-i18n="saveSettings">Save Settings</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                
                <!-- Backups Section -->
                <div id="backups" class="settings-section bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6 hidden">
                    <h2 class="text-xl font-semibold mb-6 flex items-center">
                        <i class="ri-backup-line mr-2 text-gray-500"></i>
                        <span data-i18n="backups">Backups</span>
                    </h2>
                    
                    <!-- Backup now -->
                    <div class="mb-6">
                        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4" data-i18n="backupsDesc">
                            Manage system backups and restoration. Regular backups help prevent data loss and enable quick recovery in case of system failures.
                        </p>
                        
                        <button id="backup-now-button" class="px-4 py-2 bg-coral-500 text-white rounded-lg hover:bg-coral-600 focus:outline-none focus:ring-4 focus:ring-coral-300">
                            <i class="ri-download-cloud-line mr-1"></i>
                            <span data-i18n="backupNow">Backup Now</span>
                        </button>
                    </div>
                    
                    <!-- Backup settings -->
                    <div class="mb-6">
                        <h3 class="text-lg font-medium mb-4" data-i18n="backupSettings">Backup Settings</h3>
                        
                        <form id="backup-settings-form">
                            <div class="space-y-4 mb-6">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="font-medium" data-i18n="automaticBackups">Automatic Backups</p>
                                        <p class="text-sm text-gray-500 dark:text-gray-400" data-i18n="automaticBackupsDesc">Schedule regular automatic backups</p>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" name="automatic_backups" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                
                                <div>
                                    <label for="backup-frequency" class="block text-sm font-medium mb-1" data-i18n="backupFrequency">Backup Frequency</label>
                                    <select id="backup-frequency" name="backup_frequency" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700">
                                        <option value="daily" selected data-i18n="daily">Daily</option>
                                        <option value="weekly" data-i18n="weekly">Weekly</option>
                                        <option value="biweekly" data-i18n="biweekly">Bi-weekly</option>
                                        <option value="monthly" data-i18n="monthly">Monthly</option>
                                    </select>
                                </div>
                                
                                <div>
                                    <label for="backup-time" class="block text-sm font-medium mb-1" data-i18n="backupTime">Backup Time</label>
                                    <input type="time" id="backup-time" name="backup_time" value="02:00" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700">
                                </div>
                                
                                <div>
                                    <label for="backup-retention" class="block text-sm font-medium mb-1" data-i18n="backupRetention">Backup Retention</label>
                                    <select id="backup-retention" name="backup_retention" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700">
                                        <option value="7" data-i18n="days7">7 days</option>
                                        <option value="14" data-i18n="days14">14 days</option>
                                        <option value="30" selected data-i18n="days30">30 days</option>
                                        <option value="90" data-i18n="days90">90 days</option>
                                        <option value="180" data-i18n="days180">180 days</option>
                                        <option value="365" data-i18n="year1">1 year</option>
                                    </select>
                                </div>
                                
                                <div>
                                    <label for="backup-location" class="block text-sm font-medium mb-1" data-i18n="backupLocation">Backup Location</label>
                                    <select id="backup-location" name="backup_location" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700">
                                        <option value="local" selected data-i18n="local">Local Storage</option>
                                        <option value="s3" data-i18n="s3">Amazon S3</option>
                                        <option value="azure" data-i18n="azure">Azure Blob Storage</option>
                                        <option value="gcs" data-i18n="gcs">Google Cloud Storage</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="flex justify-end">
                                <button type="submit" class="px-4 py-2 bg-coral-500 text-white rounded-lg hover:bg-coral-600 focus:outline-none focus:ring-4 focus:ring-coral-300">
                                    <span data-i18n="saveSettings">Save Settings</span>
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Backup history -->
                    <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
