                                <span data-i18n="saveSettings">Save Settings</span>
                            </button>
                        </div>
                    </form>
                </div>
                
                <!-- Repositories Section -->
                <div id="repositories" class="settings-section bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6 hidden">
                    <h2 class="text-xl font-semibold mb-6 flex items-center">
