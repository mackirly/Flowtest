                    </h2>
                    
                    <div class="mb-6">
                        <p class="text-sm text-gray-600 dark:text-gray-400" data-i18n="repositoriesDesc">
                            Connect to your test automation repositories to enable running automated tests directly from test cases.
                        </p>
                    </div>
                    
                    <!-- Connected Repositories -->
                    <div class="mb-6">
                        <div class="flex justify-between items-center mb-4">
