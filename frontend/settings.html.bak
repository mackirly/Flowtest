<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff" class="light-theme">
    <meta name="theme-color" content="#1a1f2e" class="dark-theme" disabled>
    <title>FlowTest - Settings</title>
    <base href="./" />
    <!-- StylesheetFix - load early to prevent CORS issues with external stylesheets -->
    <script src="js/stylesheet-fix-loader.js"></script>
    
    <!-- Загрузка Tailwind CSS для быстрого прототипирования -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="css/tailwind-base.css">
    <link rel="stylesheet" href="css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/lipis/flag-icons@6.6.6/css/flag-icons.min.css"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.0/flowbite.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/settings-light-override.css">
    <link rel="stylesheet" href="css/settings-nav-fix.css">
    <script type="module" src="js/utils/init-settings.js"></script>
    <style>
        /* Tab styling */
        .tab-button {
            position: relative;
            transition: all 0.2s ease;
        }
        
        .tab-button:after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            height: 2px;
            width: 0;
            background-color: var(--color-coral-500);
            transition: width 0.2s ease;
        }
        
        .tab-button.active:after {
            width: 100%;
        }
        
        /* Toggle switch */
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 24px;
        }
        
        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .4s;
            border-radius: 24px;
        }
        
        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        
        input:checked + .slider {
            background-color: var(--color-coral-500);
        }
        
        input:focus + .slider {
            box-shadow: 0 0 1px var(--color-coral-500);
        }
        
        input:checked + .slider:before {
            transform: translateX(24px);
        }
        
        /* Repository card */
        .repository-card {
            transition: all 0.3s ease;
        }
        
        .repository-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        }
        
        /* Repository connection log */
        .connection-log {
            max-height: 200px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 0.8rem;
            background-color: #0f172a;
            color: #e2e8f0;
            padding: 10px;
            border-radius: 0.375rem;
        }
        
        .log-message {
            margin-bottom: 4px;
            padding-left: 20px;
            position: relative;
        }
        
        .log-message:before {
            content: ">";
            position: absolute;
            left: 5px;
            color: #64748b;
        }
        
        .log-info {
            color: #93c5fd;
        }
        
        .log-success {
            color: #86efac;
        }
        
        .log-warning {
            color: #fde047;
        }
        
        .log-error {
            color: #fca5a5;
        }
        
        /* Badge styles */
        .badge {
            display: inline-flex;
            align-items: center;
            font-size: 0.75rem;
            font-weight: 500;
            border-radius: 9999px;
            padding: 0.125rem 0.5rem;
        }
        
        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .fade-in {
            animation: fadeIn 0.3s ease forwards;
        }
        
        /* Settings sections */
        .settings-section {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
    <script>
        // Theme will be set by init-settings.js
        
        // Simple navigation highlighting
        document.addEventListener('DOMContentLoaded', function() {
            function updateActiveLink() {
                const currentHash = window.location.hash.substring(1) || 'general';
                
                document.querySelectorAll('.settings-nav-link').forEach(link => {
                    const linkHash = link.getAttribute('href')?.substring(1);
                    
                    if (linkHash === currentHash) {
                        link.classList.add('font-semibold');
                        // Show sections
                        const sectionId = linkHash || 'general';
                        document.querySelectorAll('.settings-section').forEach(section => {
                            section.classList.toggle('hidden', section.id !== sectionId);
                        });
                    } else {
                        link.classList.remove('font-semibold');
                    }
                });
            }
            
            // Update on load and hash change
            updateActiveLink();
            window.addEventListener('hashchange', updateActiveLink);
        });
        
    </script>
    <div class="min-h-screen flex flex-col">
        <div class="flex flex-1">
            <!-- Sidebar -->
            <aside class="w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 hidden md:block">
            <div class="p-4 sticky top-0">
                <img src="images/FlowTest.png" alt="Company Logo" class="h-12 w-auto mb-8" data-i18n="companyLogo">
                <nav class="space-y-2">
                    <a href="index.html" class="flex items-center p-2 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-coral-50 dark:hover:bg-gray-700 hover:text-coral-600 dark:hover:text-coral-400 group">
                        <i class="ri-dashboard-line text-xl mr-3"></i>
                        <span data-i18n="dashboard">Панель управления</span>
                    </a>

                    <a href="test-cases.html" class="flex items-center p-2 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-coral-50 dark:hover:bg-gray-700 hover:text-coral-600 dark:hover:text-coral-400 group">
                        <i class="ri-file-list-line text-xl mr-3"></i>
                        <span data-i18n="testCases">Тест-кейсы</span>
                    </a>

                    <a href="reports.html" class="flex items-center p-2 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-coral-50 dark:hover:bg-gray-700 hover:text-coral-600 dark:hover:text-coral-400 group">
                        <i class="ri-file-chart-line text-xl mr-3"></i>
                        <span data-i18n="reports">Отчеты</span>
                    </a>

                    <a href="events.html" class="flex items-center p-2 text-gray-600 dark:text-gray-300 rounded-lg hover:bg-coral-50 dark:hover:bg-gray-700 hover:text-coral-600 dark:hover:text-coral-400 group">
                        <i class="ri-calendar-event-line text-xl mr-3"></i>
                        <span data-i18n="events">События</span>
                    </a>
                    
                </nav>
            </div>
        </aside>

        <div class="flex-1 bg-gray-50 dark:bg-gray-900">
            <!-- Header -->
            <header class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
                <div class="flex items-center justify-between p-4">
                    <h1 class="text-2xl font-semibold text-gray-800 dark:text-gray-200" data-i18n="systemSettings">Системные настройки</h1>
                    <div class="flex items-center space-x-4 ml-auto">
                        <!-- Notifications -->
                        <div id="notifications-wrapper" class="relative">
                            <button type="button" id="notifications-button"
                                    class="relative p-2 text-gray-600 dark:text-gray-300 hover:text-coral-600 dark:hover:text-coral-400">
                                <span id="notification-count" class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/2 -translate-y-1/2 bg-coral-600 rounded-full hidden">0</span>
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                                </svg>
                                <span class="sr-only" data-i18n="notifications">Уведомления</span>
                            </button>
                        </div>

                        <!-- User Menu -->
                        <div class="relative" id="user-dropdown-wrapper">
                            <button type="button" id="user-menu-button" class="flex items-center space-x-2">
                                <div id="user-avatar" class="relative w-10 h-10 rounded-full bg-coral-500 flex items-center justify-center text-white overflow-hidden">
                                    <img id="user-avatar-img" class="hidden w-full h-full object-cover" src="" alt="User avatar">
                                    <span id="user-initials" class="text-sm font-medium">U</span>
                                </div>
                                <span id="user-name" class="hidden sm:block text-sm font-medium text-gray-700 dark:text-gray-300">Загрузка...</span>
                                <svg class="-mr-1 h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                </svg>
                            </button>
                            
                            <!-- Dropdown Menu -->
                            <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white dark:bg-gray-700 ring-1 ring-black ring-opacity-5 focus:outline-none z-50">
                                <div class="py-1">
                                    <a href="profile.html" class="block px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600">
                                        <i class="ri-user-line mr-2"></i>
                                        <span data-i18n="profile">Профиль</span>
                                    </a>
                                    <hr class="my-1 border-gray-200 dark:border-gray-600">
                                    <button id="logout-button" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600">
                                        <i class="ri-logout-box-line mr-2"></i>
                                        <span data-i18n="logout">Выйти</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
    
    <!-- Main content -->
    <div class="flex-grow">
    <main class="container mx-auto px-4 py-6 pb-20">
        
        <!-- Settings content -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Left sidebar - Settings menu -->
            <div class="lg:col-span-1">
                <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4">
                    <nav class="space-y-1">
                        <a href="#general" class="settings-nav-link flex items-center text-gray-800 dark:text-gray-200 py-3 px-4 rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                            <i class="ri-settings-line mr-3 text-gray-500"></i>
                            <span data-i18n="general">Общие</span>
                        </a>
                        <a href="#users" class="settings-nav-link flex items-center text-gray-800 dark:text-gray-200 py-3 px-4 rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                            <i class="ri-user-settings-line mr-3 text-gray-500"></i>
                            <span data-i18n="userManagement">Управление пользователями</span>
                        </a>
                        <a href="#repositories" class="settings-nav-link flex items-center text-gray-800 dark:text-gray-200 py-3 px-4 rounded hover:bg-gray-100 dark:hover:bg-gray-700">
                            <i class="ri-git-repository-line mr-3 text-gray-500"></i>
                            <span data-i18n="repositories">Репозитории</span>
                        </a>
                    </nav>
                </div>
            </div>
            
            <!-- Right content area - Settings Forms -->
            <div class="lg:col-span-3">
                <!-- General Settings Section -->
                <div id="general" class="settings-section bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6 block text-gray-800 dark:text-white">
                    <h2 class="text-xl font-semibold mb-6 flex items-center">
                        <i class="ri-settings-line mr-2 text-gray-500"></i>
                        <span data-i18n="general">General</span>
                    </h2>
                    
                    <form id="general-settings-form">
                        <!-- System Name -->
                        <div class="mb-4">
                            <label for="system-name" class="block text-sm font-medium mb-1" data-i18n="systemName">System Name</label>
                            <input type="text" id="system-name" name="system_name" value="FlowTest" 
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="systemNameDesc">This name will be displayed in the application title and emails.</p>
                        </div>
                        
                        <!-- Default Languages -->
                        <div class="mb-4">
                            <label for="default-language" class="block text-sm font-medium mb-1" data-i18n="defaultLanguage">Default Language</label>
                            <select id="default-language" name="default_language" 
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                                <option value="en" selected>English</option>
                                <option value="ru">Русский</option>
                                <option value="de">Deutsch</option>
                            </select>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="defaultLanguageDesc">This language will be used for new users and anonymous sessions.</p>
                        </div>
                        
                        <!-- Default Theme -->
                        <div class="mb-4">
                            <label for="default-theme" class="block text-sm font-medium mb-1" data-i18n="defaultTheme">Default Theme</label>
                            <select id="default-theme" name="default_theme" 
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                                <option value="light" selected data-i18n="light">Light</option>
                                <option value="dark" data-i18n="dark">Dark</option>
                                <option value="system" data-i18n="system">System</option>
                            </select>
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="defaultThemeDesc">This theme will be used for new users and anonymous sessions.</p>
                        </div>
                        
                        <!-- Date and Time Format -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div>
                                <label for="date-format" class="block text-sm font-medium mb-1" data-i18n="dateFormat">Date Format</label>
                                <select id="date-format" name="date_format" 
                                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                                    <option value="MM/DD/YYYY" selected>MM/DD/YYYY</option>
                                    <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                                    <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                                </select>
                            </div>
                            
                            <div>
                                <label for="time-format" class="block text-sm font-medium mb-1" data-i18n="timeFormat">Time Format</label>
                                <select id="time-format" name="time_format" 
                                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                                    <option value="12" selected>12-hour (AM/PM)</option>
                                    <option value="24">24-hour</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Default Timezone -->
                        <div class="mb-4">
                            <label for="default-timezone" class="block text-sm font-medium mb-1" data-i18n="defaultTimezone">Default Timezone</label>
                            <select id="default-timezone" name="default_timezone" 
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white">
                                <option value="UTC-12:00">(UTC-12:00) International Date Line West</option>
                                <option value="UTC-11:00">(UTC-11:00) Coordinated Universal Time-11</option>
                                <option value="UTC-10:00">(UTC-10:00) Hawaii</option>
                                <option value="UTC-09:00">(UTC-09:00) Alaska</option>
                                <option value="UTC-08:00">(UTC-08:00) Pacific Time (US & Canada)</option>
                                <option value="UTC-07:00">(UTC-07:00) Mountain Time (US & Canada)</option>
                                <option value="UTC-06:00">(UTC-06:00) Central Time (US & Canada)</option>
                                <option value="UTC-05:00">(UTC-05:00) Eastern Time (US & Canada)</option>
                                <option value="UTC-04:00">(UTC-04:00) Atlantic Time (Canada)</option>
                                <option value="UTC-03:00">(UTC-03:00) Brasilia</option>
                                <option value="UTC+00:00" selected>(UTC+00:00) London, Edinburgh, Dublin, Lisbon</option>
                                <option value="UTC+01:00">(UTC+01:00) Berlin, Brussels, Copenhagen, Madrid, Paris</option>
                                <option value="UTC+02:00">(UTC+02:00) Athens, Bucharest, Istanbul</option>
                                <option value="UTC+03:00">(UTC+03:00) Moscow, St. Petersburg, Volgograd</option>
                                <option value="UTC+05:30">(UTC+05:30) Chennai, Kolkata, Mumbai, New Delhi</option>
                                <option value="UTC+08:00">(UTC+08:00) Beijing, Hong Kong, Singapore, Taipei</option>
                                <option value="UTC+09:00">(UTC+09:00) Osaka, Sapporo, Tokyo</option>
                                <option value="UTC+10:00">(UTC+10:00) Canberra, Melbourne, Sydney</option>
                                <option value="UTC+12:00">(UTC+12:00) Auckland, Wellington</option>
                            </select>
                        </div>
                        
                        <!-- Пользовательский интерфейс для новой секции "Управление пользователями" будет добавлен в соответствующем разделе -->
                        
                        <div class="flex justify-end">
