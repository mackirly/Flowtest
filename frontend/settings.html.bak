                <p class="text-gray-600 dark:text-gray-400 text-sm">&copy; 2025 FlowTest 2.0. All rights reserved.</p>
                <div class="flex space-x-4 mt-4 md:mt-0">
                    <a href="#" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 text-sm" data-i18n="privacyPolicy">Privacy Policy</a>
                    <a href="#" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 text-sm" data-i18n="termsOfService">Terms of Service</a>
                    <a href="#" class="text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 text-sm" data-i18n="contact">Contact</a>
                </div>
            </div>
        </div>
    </footer>
    
    <!-- Add Repository Modal -->
    <div id="add-repository-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 items-center justify-center">
        <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow max-w-2xl w-full">
            <div class="p-6">
                <button id="close-repository-modal" class="absolute top-3 right-3 text-gray-400 hover:text-gray-500 dark:hover:text-gray-300">
                    <i class="ri-close-line text-2xl"></i>
                </button>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6" data-i18n="addRepository">Add Repository</h3>
                
                <div class="mb-6">
                    <div class="flex space-x-4 mb-4">
                        <button class="repo-type-btn flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 active" data-type="git">
                            <i class="ri-git-branch-line mr-1"></i>
                            <span data-i18n="git">Git</span>
                        </button>
                        <button class="repo-type-btn flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600" data-type="github">
                            <i class="ri-github-fill mr-1"></i>
                            <span>GitHub</span>
                        </button>
                        <button class="repo-type-btn flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600" data-type="gitlab">
                            <i class="ri-gitlab-fill mr-1"></i>
                            <span>GitLab</span>
                        </button>
                        <button class="repo-type-btn flex-1 px-3 py-2 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600" data-type="bitbucket">
                            <i class="ri-bit-coin-line mr-1"></i>
                            <span>Bitbucket</span>
                        </button>
                    </div>
                    
                    <form id="add-repository-form">
                        <!-- Git Repository Settings -->
                        <div id="git-repo-settings">
                            <div class="mb-4">
                                <label for="git-repo-url" class="block text-sm font-medium mb-1" data-i18n="repositoryUrl">Repository URL</label>
                                <input type="text" id="git-repo-url" name="git_repo_url" placeholder="https://github.com/username/repository.git" data-i18n-placeholder="repositoryUrlPlaceholder"
                                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                            </div>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label for="git-branch" class="block text-sm font-medium mb-1" data-i18n="branch">Branch</label>
                                    <input type="text" id="git-branch" name="git_branch" placeholder="main" data-i18n-placeholder="branchPlaceholder"
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                </div>
                                
                                <div>
                                    <label for="git-framework" class="block text-sm font-medium mb-1" data-i18n="framework">Test Framework</label>
                                    <select id="git-framework" name="git_framework" 
                                        class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                        <option value="pytest" selected>Pytest</option>
                                        <option value="jest">Jest</option>
                                        <option value="mocha">Mocha</option>
                                        <option value="junit">JUnit</option>
                                        <option value="testng">TestNG</option>
                                        <option value="selenium">Selenium</option>
                                        <option value="cypress">Cypress</option>
                                        <option value="playwright">Playwright</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <label for="git-test-path" class="block text-sm font-medium mb-1" data-i18n="testPath">Tests Directory Path</label>
                                <input type="text" id="git-test-path" name="git_test_path" placeholder="tests/" data-i18n-placeholder="testPathPlaceholder"
                                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="testPathDesc">Relative path to the directory containing test files</p>
                            </div>
                            
                            <div class="mb-4">
                                <label for="git-test-pattern" class="block text-sm font-medium mb-1" data-i18n="testPattern">Test File Pattern</label>
                                <input type="text" id="git-test-pattern" name="git_test_pattern" placeholder="test_*.py" data-i18n-placeholder="testPatternPlaceholder"
                                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="testPatternDesc">Pattern to match test files (e.g., test_*.py, *.test.js)</p>
                            </div>
                            
                            <div class="border-t border-gray-200 dark:border-gray-700 pt-4 mb-4">
                                <p class="font-medium mb-2" data-i18n="authentication">Authentication</p>
                                
                                <div class="mb-4">
                                    <label class="flex items-center mb-1">
                                        <input type="radio" name="git_auth_type" value="none" checked class="mr-2">
                                        <span class="text-sm" data-i18n="noAuth">No Authentication</span>
                                    </label>
                                    <label class="flex items-center mb-1">
                                        <input type="radio" name="git_auth_type" value="ssh" class="mr-2">
                                        <span class="text-sm" data-i18n="sshKey">SSH Key</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="radio" name="git_auth_type" value="basic" class="mr-2">
                                        <span class="text-sm" data-i18n="usernamePassword">Username & Password</span>
                                    </label>
                                </div>
                                
                                <div id="ssh-key-auth" class="hidden mb-4">
                                    <div class="mb-4">
                                        <label for="git-ssh-key" class="block text-sm font-medium mb-1" data-i18n="sshPrivateKey">SSH Private Key</label>
                                        <textarea id="git-ssh-key" name="git_ssh_key" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700"></textarea>
                                    </div>
                                    
                                    <div>
                                        <label for="git-ssh-passphrase" class="block text-sm font-medium mb-1" data-i18n="sshPassphrase">SSH Passphrase (if any)</label>
                                        <input type="password" id="git-ssh-passphrase" name="git_ssh_passphrase" 
                                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                    </div>
                                </div>
                                
                                <div id="basic-auth" class="hidden">
                                    <div class="mb-4">
                                        <label for="git-username" class="block text-sm font-medium mb-1" data-i18n="username">Username</label>
                                        <input type="text" id="git-username" name="git_username" 
                                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                    </div>
                                    
                                    <div>
                                        <label for="git-password" class="block text-sm font-medium mb-1" data-i18n="password">Password / Access Token</label>
                                        <input type="password" id="git-password" name="git_password" 
                                            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Other repository settings (GitHub, GitLab, Bitbucket) would be here, hidden by default -->
                        
                        <div class="mb-4">
                            <label for="repo-name" class="block text-sm font-medium mb-1" data-i18n="displayName">Display Name</label>
                            <input type="text" id="repo-name" name="repo_name" 
                                class="w-full px-3 py-2 border border-gray-300 dark:border-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-coral-500 bg-white dark:bg-gray-700">
                            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-i18n="displayNameDesc">A friendly name to identify this repository</p>
                        </div>
                        
                        <div class="mb-4">
                            <label class="flex items-center">
                                <input type="checkbox" name="auto_sync" checked class="mr-2">
                                <span class="text-sm" data-i18n="syncOnConnect">Sync after connecting</span>
                            </label>
                        </div>
                        
                        <div class="connection-log hidden mb-4">
                            <p class="text-sm font-medium mb-2" data-i18n="connectionLog">Connection Log</p>
                            <div id="log-container" class="connection-log">
                                <!-- Log messages will be added here dynamically -->
                            </div>
                        </div>
                        
                        <div class="flex justify-end space-x-3">
                            <button type="button" id="test-connection-button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-gray-300" data-i18n="testConnection">
                                Test Connection
                            </button>
                            <button type="button" id="cancel-repository-button" class="px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-4 focus:ring-gray-300" data-i18n="cancel">
                                Cancel
                            </button>
                            <button type="submit" class="px-4 py-2 bg-coral-500 text-white rounded-lg hover:bg-coral-600 focus:outline-none focus:ring-4 focus:ring-coral-300" data-i18n="connect">
                                Connect
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script type="module" src="js/utils/toast.js"></script>
    <script type="module" src="js/i18n/translations.js"></script>
    <script type="module" src="js/i18n/i18n.js"></script>
    <script type="module" src="js/api/client.js"></script>
    <script src="js/settings-fixed.js"></script>
    <script type="module" src="js/pages/settings.js"></script>
    
    <!-- Auth Guard initialization -->
    <script type="module" src="./js/init-auth.js"></script>
</body>
</html>