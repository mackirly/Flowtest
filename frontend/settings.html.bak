                                <span data-i18n="addRepository">Add Repository</span>
                            </button>
                        </div>
                        
                        <div id="repositories-list" class="space-y-4">
                            <!-- Repository 1 -->
                            <div class="repository-card bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4">
                                    <div class="flex items-center mb-2 sm:mb-0">
                                        <div class="mr-3 text-blue-500 dark:text-blue-400">
                                            <i class="ri-github-fill text-2xl"></i>
                                        </div>
                                        <div>
                                            <p class="font-medium">E-Commerce Test Suite</p>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">github.com/example/ecommerce-tests</p>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="badge bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                            <span data-i18n="connected">Connected</span>
                                        </span>
                                    </div>
                                </div>
                                
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                    <div>
                                        <p class="text-xs text-gray-500 dark:text-gray-400" data-i18n="branch">Branch</p>
                                        <p class="text-sm">main</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 dark:text-gray-400" data-i18n="lastSync">Last Sync</p>
                                        <p class="text-sm">May 15, 2025 13:45</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 dark:text-gray-400" data-i18n="testCount">Test Count</p>
                                        <p class="text-sm">126 tests</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 dark:text-gray-400" data-i18n="framework">Framework</p>
                                        <p class="text-sm">Pytest</p>
                                    </div>
                                </div>
                                
                                <div class="border-t border-gray-200 dark:border-gray-700 pt-4 flex items-center justify-end space-x-2">
                                    <button class="px-3 py-1.5 bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600">
                                        <i class="ri-refresh-line mr-1"></i>
                                        <span data-i18n="sync">Sync</span>
                                    </button>
                                    <button class="px-3 py-1.5 bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600">
                                        <i class="ri-settings-line mr-1"></i>
                                        <span data-i18n="settings">Settings</span>
                                    </button>
                                    <button class="px-3 py-1.5 bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300 rounded hover:bg-red-200 dark:hover:bg-red-800">
                                        <i class="ri-delete-bin-line mr-1"></i>
                                        <span data-i18n="disconnect">Disconnect</span>
                                    </button>
                                </div>
                            </div>
                            
                            <!-- Repository 2 -->
                            <div class="repository-card bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4">
                                    <div class="flex items-center mb-2 sm:mb-0">
                                        <div class="mr-3 text-indigo-500 dark:text-indigo-400">
                                            <i class="ri-gitlab-fill text-2xl"></i>
                                        </div>
                                        <div>
                                            <p class="font-medium">API Integration Tests</p>
                                            <p class="text-xs text-gray-500 dark:text-gray-400">gitlab.com/company/api-tests</p>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="badge bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                                            <span data-i18n="connected">Connected</span>
