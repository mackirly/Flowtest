                                        <p class="text-sm">develop</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 dark:text-gray-400" data-i18n="lastSync">Last Sync</p>
                                        <p class="text-sm">May 14, 2025 09:12</p>
